# Copy to infra/.env and fill in. Every value here is optional — the stack
# boots without it. Docker Compose reads this file automatically.

# Real Gemini key. Without it the app runs, but coverage analysis, portfolio
# generation and fit-gap generation will fail at the HTTP call.
GEMINI_API_KEY=

# Only needs to match rakamin-api in a real deployment. Any value works locally.
SECRET_KEY_BASE=

# Paste a JWT here to skip the login screen in the web app.
# Mint one with:  make console
#   JsonWebToken.encode({ user_id: 1, role: 'admin', scheme: 'test-corp' })
VITE_DEV_TOKEN=

# Host-side port overrides, in case these collide on your machine.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=3001
WEB_HOST_PORT=5173
